NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# 데모(서버 전용). true일 때만 로그인 화면에 "데모로 둘러보기"가 보인다. Supabase 익명 로그인이 켜져 있어야 한다
DEMO_ENABLED=
# 메일 링크가 돌아올 앱 주소(서버 전용). 비우면 Supabase Auth의 site_url을 쓴다
SITE_URL=
# 알림 발송(서버 전용). 아래 값이 모두 있어야 설정 > 알림의 이메일·푸시 스위치가 켜진다
# dispatch 라우트가 RLS를 우회해 알림을 읽을 때 쓰는 service role 키. 이 경로에서만 쓰고 클라이언트에 노출하지 않는다
SUPABASE_SERVICE_ROLE_KEY=
# /api/notifications/dispatch 호출 인증. Vercel 크론이 Authorization: Bearer 로 보낸다. 긴 무작위 문자열을 쓴다
CRON_SECRET=
# 이메일 발송용 SMTP 주소(예 smtp://user:pass@host:587). 비우면 이메일 알림을 켤 수 없다
SMTP_URL=
# 이메일 보낸 사람(예 Taskmanagement <noreply@example.com>)
MAIL_FROM=
# 웹 푸시 VAPID 키 쌍과 연락처(mailto: 또는 https: 주소). `pnpm dlx web-push generate-vapid-keys`로 만든다. 공개 키만 브라우저에 전달된다
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
